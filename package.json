{
  "name": "mulk-yonetim",
  "private": true,
  "version": "1.0.8",
  "author": "CZT Studios",
  "description": "Mülk ve Kira Yönetim Sistemi",
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ggokhan58/mulkyonetim.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --win --publish never && node scripts/verify-release.cjs",
    "test:updater": "node --test scripts/updater.test.cjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "electron": "^42.4.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.cztstudios.mulkyonetim",
    "productName": "Mülk Yönetim",
    "publish": [
      {
        "provider": "github",
        "owner": "ggokhan58",
        "repo": "mulkyonetim"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll,dylib,so}",
      "node_modules/better-sqlite3"
    ],
    "extraResources": [
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ],
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "win": {
      "artifactName": "mulk-yonetim-setup-${version}.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mülk Yönetim"
    }
  }
}
